# MongoDB 연결 문자열 (MongoDB Atlas 또는 로컬 MongoDB)
MONGODB_URI=mongodb://localhost:27017/team_project_db

# JWT 토큰 서명용 비밀키 (배포 시 반드시 변경)
JWT_SECRET=change-this-secret-key

# 서버 포트
PORT=3000

# (선택) 인증코드 메일 발송용 SMTP 설정
# 설정하지 않으면 인증코드가 서버 콘솔에 출력되고 화면에도 표시됩니다(개발 모드).
# Gmail 예시: 2단계 인증 후 "앱 비밀번호"를 발급해 사용하세요.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=조각 <your-email@gmail.com>
